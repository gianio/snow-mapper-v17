__pycache__/
*.pyc
# Local virtualenv (macOS ships a PEP 668 "externally managed" python, so a
# venv is the normal way to install requirements.txt there).
.venv/
venv/
index.html
# Build artifacts (generated by the pipeline; split build goes to dist/)
manifest.webmanifest
sw.js
icon-180.png
icon-192.png
icon-512.png
app.js
/dist/

# Web app
web/node_modules/
web/dist/
web/.env
web/.env.local
# NOTE: tools/cache/ is intentionally NOT ignored — commit it to activate the
# offline powder-engine regression gate in CI (see docs/launch-checklist.md).

# Variant A (SNOWPACK ski-quality pipeline)
#
# outputs/ and the cache are WORKING directories -- .sno/.ini/.pro state, raw
# runs, every intermediate. They stay ignored.
#
# What the app actually needs is the small exported bundle, and it has its own
# home so that promoting a run is deliberate rather than "whatever is in
# outputs/ right now":
#
#     python run_variant_a.py --date 2026-04-01
#     rsync -a --delete outputs/variant_a/ variant_a_export/
#     git add variant_a_export && git commit
#
# deploy.yml copies variant_a_export/ into dist/data/variant_a/ when it exists.
# variant_a_export/ is NOT listed here, so it commits normally -- there is no
# rule to un-ignore. The two lines below are the ones that would otherwise
# swallow an export left in outputs/.
outputs/variant_a/
data/variant_a_cache/
# NOTE: git has no trailing comments in .gitignore -- a '#' only starts a
# comment at the START of a line. This pattern previously carried its
# explanation on the same line, which made it the literal string
# "*.dem          # large national DEM ..." and match nothing, so an 8.6 MB
# generated DEM showed up as untracked and ready to be committed by accident.
# Large national DEM: generated by tools/make_variant_a_dem.py, never committed.
variant_a/data/dem/*.dem

# Generated by the CI run instead (.github/workflows/variant-a.yml), which
# uploads the bundle as an artifact rather than committing it.
/snowpack-build/

# DEM cache: the small national tiles (1-3 km) are committed on purpose so CI
# does not re-download them. Anything finer is a by-product of a one-off run --
# the 52 m national tile from the tiling prototype was 94 MB and got swept in
# by a `git add -A`, which is exactly what this rule prevents.
data/dem_cache/*_2[0-9][0-9].tif
data/dem_cache/*_1[0-9][0-9].tif
data/dem_cache/*_[1-9][0-9].tif
data/dem_cache/*_[1-9].tif
