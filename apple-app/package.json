{
  "name": "snow-model-ios",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor iOS wrapper for the Swiss Snow Model web app. The web app itself is generated by ../pipeline/interactive_export.py and is unchanged; this project bundles it as native app assets and adds iOS-native integrations.",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "resources": "python3 scripts/make-resources.py",
    "add:ios": "cap add ios",
    "assets": "capacitor-assets generate --ios",
    "sync": "cap sync ios",
    "open": "cap open ios",
    "ios": "npm run build:web && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.2",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  }
}
